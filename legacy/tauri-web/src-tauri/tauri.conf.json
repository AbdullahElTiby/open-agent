{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Agent",
  "version": "0.1.0",
  "identifier": "dev.openagent.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Agent",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#05060a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
